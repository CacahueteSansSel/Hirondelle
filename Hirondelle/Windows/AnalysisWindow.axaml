<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windevReader="clr-namespace:WindevReader;assembly=WindevReader"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="450"
        x:Class="Hirondelle.Windows.AnalysisWindow"
        Title="Visualisateur de l'analyse du projet" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Left" Width="300">
            <StackPanel DockPanel.Dock="Top" Margin="0 0 0 5">
                <TextBlock x:Name="AnalysisVersionText" FontWeight="Bold">Analyse v0</TextBlock>
                <TextBlock x:Name="AnalysisGuidText">GUID</TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0 5 0 0" Spacing="4">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="EFExportButtonClicked">Exporter vers Entity Framework</Button>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="JsonExportButtonClicked">Exporter en JSON</Button>
            </StackPanel>
            <ListBox x:Name="TableList" SelectionChanged="TableList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="windevReader:WindevDataTable">
                        <TextBlock Text="{Binding Name}"></TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <DockPanel Margin="10,0">
            <StackPanel Orientation="Vertical" DockPanel.Dock="Top">
                <TextBlock x:Name="TableNameText" FontWeight="Bold">Nom du fichier</TextBlock>
                <TextBlock x:Name="TableCaptionText" FontWeight="Bold">Libellé</TextBlock>
                <TextBlock x:Name="TablePhysicalNameText">Nom physique</TextBlock>
                <StackPanel Orientation="Horizontal" Margin="40 5 0 0">
                    <TextBlock FontSize="12" Width="300">Nom</TextBlock>
                    <TextBlock FontSize="12" Width="300">Description</TextBlock>
                    <TextBlock FontSize="12" Width="100">Type</TextBlock>
                </StackPanel>
            </StackPanel>
            <ListBox x:Name="FieldsList">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="windevReader:WindevDataField">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <StackPanel Orientation="Horizontal" Height="20" VerticalAlignment="Center">
                                <Svg Path="/Resources/icons/key.svg" DockPanel.Dock="Left" ToolTip.Tip="Clé primaire"
                                     CurrentColor="Green" Width="20" Height="20" IsVisible="{Binding IsPrimaryKey}" />
                                <Svg Path="/Resources/icons/composed_key.svg" DockPanel.Dock="Left" ToolTip.Tip="Clé composée"
                                     CurrentColor="{DynamicResource SystemBaseHighColor}" Width="20" Height="20" IsVisible="{Binding IsCompositeKey}" />
                                <Svg Path="/Resources/icons/double_key.svg" DockPanel.Dock="Left" ToolTip.Tip="Clé doublon"
                                     CurrentColor="{DynamicResource SystemBaseHighColor}" Width="20" Height="20" IsVisible="{Binding AllowsDuplicates}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" Width="300"></TextBlock>
                            <TextBlock Text="{Binding Caption}" Width="300"></TextBlock>
                            <TextBlock Text="{Binding Type}" Width="100"></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>